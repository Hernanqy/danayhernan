* {
  box-sizing: border-box;
}

html,
body {
  padding: 0;
  margin: 0;
  width: 100%;
  min-height: 100%;
}

body {
  background: #f7f4ed;
  color: #25241f;
  font-family: Georgia, "Times New Roman", serif;
}

button,
input {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

/* APP */

.experiencia {
  width: 100%;
  min-height: 100dvh;
  overflow: hidden;
  position: relative;
  background:
    radial-gradient(
      circle at 20% 10%,
      rgba(188, 159, 107, 0.08),
      transparent 35%
    ),
    #f7f4ed;
}

.pantalla {
  width: 100%;
  min-height: 100dvh;
}

.contenido {
  width: 100%;
  min-height: 100dvh;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  position: relative;

  padding: 60px 24px 80px;

  cursor: pointer;
}

/* ILUSTRACIONES */

.ilustracion {
  position: absolute;

  width: min(320px, 70vw);
  max-height: 42vh;

  object-fit: contain;

  bottom: 65px;
  right: -15px;

  pointer-events: none;

  opacity: 0.95;
}

/* PRIMERA PANTALLA */

.texto-central {
  text-align: center;

  position: relative;

  z-index: 2;

  margin-top: -100px;
}

.mini {
  font-family: Arial, Helvetica, sans-serif;

  font-size: 11px;

  letter-spacing: 0.32em;

  text-transform: uppercase;

  margin-bottom: 20px;

  opacity: 0.6;
}

h1 {
  font-family:
    "Segoe Script",
    "Brush Script MT",
    cursive;

  font-weight: 400;

  font-size: clamp(55px, 15vw, 100px);

  line-height: 0.8;

  margin: 0;
}

h1 .amp {
  display: block;

  font-family: Georgia, serif;

  font-size: 28px;

  margin: 20px 0;

  font-style: italic;
}

.linea {
  height: 1px;
  width: 70px;

  background: #25241f;

  opacity: 0.4;

  margin: 32px auto;
}

.fecha-principal {
  font-size: 20px;

  letter-spacing: 0.08em;

  margin: 0;
}

/* GUARDA LA FECHA */

.frase-grande {
  z-index: 2;

  text-align: center;

  margin-top: -150px;
}

.frase-grande span {
  display: block;

  font-family:
    "Segoe Script",
    "Brush Script MT",
    cursive;

  font-size: clamp(60px, 17vw, 100px);

  line-height: 1;
}

.frase-grande strong {
  display: block;

  margin-top: 6px;

  font-size: clamp(38px, 11vw, 68px);

  font-weight: 400;

  font-style: italic;
}

/* FECHA */

.fecha-gigante {
  text-align: center;

  z-index: 2;

  margin-top: -100px;
}

.fecha-gigante p {
  font-size: clamp(75px, 23vw, 145px);

  line-height: 0.78;

  margin: 10px 0;

  font-weight: 400;
}

.fecha-gigante span {
  display: block;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 14px;

  letter-spacing: 0.45em;

  margin-left: 0.45em;

  opacity: 0.65;
}

/* CIVIL */

.civil {
  text-align: center;

  position: relative;

  z-index: 2;

  margin-top: -100px;
}

.civil h2 {
  font-family:
    "Segoe Script",
    "Brush Script MT",
    cursive;

  font-size: clamp(75px, 20vw, 125px);

  font-weight: 400;

  margin: 0 0 25px;

  line-height: 1;
}

.datos {
  border-top: 1px solid rgba(0, 0, 0, 0.25);

  border-bottom: 1px solid rgba(0, 0, 0, 0.25);

  padding: 18px 40px;
}

.datos p {
  font-size: 20px;

  margin: 0 0 8px;

  letter-spacing: 0.08em;
}

.datos strong {
  font-family: Arial, Helvetica, sans-serif;

  font-size: 14px;

  letter-spacing: 0.2em;

  font-weight: 500;
}

/* FINAL */

.respuesta {
  cursor: default;

  justify-content: flex-start;

  padding-top: 70px;

  overflow-y: auto;
}

.respuesta-contenido {
  position: relative;

  z-index: 5;

  width: 100%;

  max-width: 470px;
}

.respuesta h2 {
  font-family:
    "Segoe Script",
    "Brush Script MT",
    cursive;

  font-weight: 400;

  font-size: clamp(70px, 19vw, 110px);

  margin: 0;

  line-height: 1;
}

.subtitulo {
  font-size: 16px;

  line-height: 1.5;

  opacity: 0.72;

  max-width: 330px;

  margin-bottom: 30px;
}

/* INPUT */

.input-nombre {
  width: 100%;

  border: none;

  border-bottom: 1px solid rgba(0, 0, 0, 0.35);

  background: transparent;

  padding: 15px 2px;

  font-size: 18px;

  color: #25241f;

  outline: none;

  margin-bottom: 25px;
}

.input-nombre::placeholder {
  color: rgba(37, 36, 31, 0.48);
}

/* OPCIONES */

.opciones {
  display: flex;

  flex-direction: column;

  gap: 10px;
}

.opcion {
  width: 100%;

  display: flex;

  align-items: center;

  gap: 15px;

  text-align: left;

  border: 1px solid rgba(37, 36, 31, 0.18);

  background: rgba(255, 255, 255, 0.45);

  border-radius: 18px;

  padding: 16px 18px;

  cursor: pointer;

  color: #25241f;

  transition: 0.25s;
}

.opcion > span {
  width: 34px;
  height: 34px;

  border: 1px solid rgba(37, 36, 31, 0.3);

  border-radius: 50%;

  display: flex;

  justify-content: center;

  align-items: center;

  flex-shrink: 0;

  font-size: 21px;
}

.opcion strong {
  display: block;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 15px;

  margin-bottom: 4px;
}

.opcion small {
  font-size: 13px;

  opacity: 0.58;
}

.opcion:hover {
  transform: translateY(-2px);
}

.opcion.seleccionada {
  border-color: #798169;

  background: #e7e9dc;

  transform: scale(1.015);
}

.opcion.seleccionada > span {
  background: #798169;

  color: white;

  border-color: #798169;
}

/* ENVIAR */

.enviar {
  width: 100%;

  margin-top: 20px;

  border: none;

  border-radius: 50px;

  padding: 17px 20px;

  background: #25241f;

  color: #fff;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 14px;

  letter-spacing: 0.08em;

  cursor: pointer;

  transition: 0.25s;
}

.enviar:hover:not(:disabled) {
  transform: translateY(-2px);
}

.enviar:disabled {
  opacity: 0.25;

  cursor: default;
}

/* GRACIAS */

.gracias {
  text-align: center;
}

.gracias h2 {
  font-family:
    "Segoe Script",
    "Brush Script MT",
    cursive;

  font-size: clamp(70px, 19vw, 110px);

  font-weight: 400;

  margin: 10px;
}

.gracias p {
  font-size: 18px;
}

.gracias strong {
  font-family:
    "Segoe Script",
    "Brush Script MT",
    cursive;

  font-size: 28px;
}

.corazon {
  display: block;

  font-size: 70px;
}

/* NAVEGACIÃƒâ€œN */

.continuar {
  position: absolute;

  bottom: 25px;

  left: 50%;

  transform: translateX(-50%);

  display: flex;

  align-items: center;

  gap: 10px;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 10px;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  opacity: 0.48;

  white-space: nowrap;
}

.continuar span {
  font-size: 17px;
}

.indicador {
  position: fixed;

  top: 22px;

  left: 50%;

  transform: translateX(-50%);

  display: flex;

  gap: 7px;

  z-index: 50;
}

.indicador span {
  width: 22px;
  height: 3px;

  border-radius: 10px;

  background: rgba(0, 0, 0, 0.15);

  transition: 0.3s;
}

.indicador span.activo {
  background: #25241f;

  width: 34px;
}

.volver {
  position: fixed;

  top: 18px;

  left: 18px;

  z-index: 100;

  border: none;

  width: 38px;
  height: 38px;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.8);

  color: #25241f;

  font-size: 20px;

  cursor: pointer;
}

/* ESCRITORIO */

@media (min-width: 800px) {
  .contenido {
    max-width: 800px;

    margin: auto;
  }

  .ilustracion {
    width: 360px;

    right: 20px;
  }

  .respuesta {
    justify-content: center;

    padding-top: 50px;
  }
}
/* AJUSTE FECHA */

.fecha-gigante {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.fecha-gigante p {
  margin: 0;
  line-height: 0.9;
}

.fecha-gigante span {
  display: block;
  margin: 18px 0 20px 0;
  padding-left: 0.45em;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 13px;
  line-height: 1;

  letter-spacing: 0.45em;

  position: relative;
  z-index: 5;
}


/* =========================
   PORTADA HERNAN Y DANA
   ========================= */

.portada {
  background: #f6f3ec;
}

.portada-texto {
  margin: 0 !important;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  min-height: 75vh;
}

.nombres {
  margin: 0;
  padding: 0;

  display: flex;
  flex-direction: column;
  align-items: center;

  font-family:
    "Segoe Script",
    "Brush Script MT",
    cursive;

  font-weight: 400;

  font-size: clamp(72px, 19vw, 120px);

  line-height: 0.86;

  color: #22211d;
}

.nombres > span {
  display: block;
}

.nombres .y {
  margin: 28px 0;

  font-family: Georgia, "Times New Roman", serif;

  font-size: 27px;
  line-height: 1;

  font-weight: 400;
  font-style: italic;

  color: #22211d;
}

.linea-portada {
  width: 70px;
  height: 1px;

  margin: 44px auto 30px;

  background: rgba(34, 33, 29, 0.35);
}

.fecha-principal {
  margin: 0;

  font-family: Georgia, "Times New Roman", serif;

  font-size: 20px;

  letter-spacing: 0.08em;

  color: #22211d;
}


/* ==================================
   RSVP - MENU FINAL MAS CREATIVO
   ================================== */

.nueva-respuesta {
  background: #f6f3ec;
  justify-content: center;
  padding: 50px 22px;
}

.respuesta-contenido {
  width: 100%;
  max-width: 430px;
}

.pregunta-mini {
  margin: 0 0 10px;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 10px;
  letter-spacing: 0.35em;

  color: #817c72;
}

.venis {
  margin: 0;

  font-family:
    "Segoe Script",
    "Brush Script MT",
    cursive;

  font-size: clamp(72px, 20vw, 110px);

  line-height: 0.95;

  font-weight: 400;

  color: #23221e;
}

.subtitulo-rsvp {
  margin: 15px 0 34px;

  font-size: 16px;
  line-height: 1.45;

  color: #777167;
}

/* NOMBRE */

.nombre-box {
  margin-bottom: 30px;

  padding: 16px 18px;

  border-radius: 18px;

  background: rgba(255,255,255,0.65);

  border: 1px solid rgba(35,34,30,0.09);
}

.nombre-box span {
  display: block;

  margin-bottom: 5px;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 9px;

  letter-spacing: 0.22em;
  text-transform: uppercase;

  color: #999185;
}

.nombre-box input {
  width: 100%;

  padding: 0;

  border: none;
  outline: none;

  background: transparent;

  font-family: Georgia, serif;
  font-size: 18px;

  color: #23221e;
}

.nombre-box input::placeholder {
  color: #b2aa9e;
}

/* TARJETAS */

.eleccion-rsvp {
  display: flex;
  flex-direction: column;

  gap: 12px;
}

.respuesta-card {
  position: relative;

  width: 100%;

  display: grid;

  grid-template-columns: 52px 1fr 34px;
  align-items: center;

  gap: 13px;

  padding: 17px 18px;

  border-radius: 22px;

  border: 1px solid rgba(35,34,30,0.11);

  background: rgba(255,255,255,0.7);

  color: #25241f;

  text-align: left;

  cursor: pointer;

  transition:
    transform .25s ease,
    background .25s ease,
    border .25s ease,
    box-shadow .25s ease;
}

.respuesta-card:hover {
  transform: translateY(-2px);

  box-shadow:
    0 8px 30px rgba(39,36,30,0.06);
}

/* ICONO */

.respuesta-icono {
  width: 48px;
  height: 48px;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  font-family: Georgia, serif;

  font-size: 25px;

  background: #ece8df;

  transition: .25s ease;
}

/* TEXTO */

.respuesta-texto strong {
  display: block;

  margin-bottom: 4px;

  font-family: Georgia, serif;

  font-size: 17px;
  font-weight: 400;
}

.respuesta-texto span {
  display: block;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 12px;

  color: #898277;
}

/* CHECK */

.check {
  width: 28px;
  height: 28px;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(35,34,30,0.18);

  font-family: Arial, Helvetica, sans-serif;

  font-size: 13px;

  transition: .25s ease;
}

/* OPCION SI */

.respuesta-card.si.activa {
  background: #e8ecdf;

  border-color: #8a9676;

  transform: scale(1.02);
}

.respuesta-card.si.activa .respuesta-icono,
.respuesta-card.si.activa .check {
  background: #7f8d6a;
  color: white;
  border-color: #7f8d6a;
}

/* OPCION DUDA */

.respuesta-card.duda.activa {
  background: #f2ead9;

  border-color: #bda46e;

  transform: scale(1.02);
}

.respuesta-card.duda.activa .respuesta-icono,
.respuesta-card.duda.activa .check {
  background: #b69b63;
  color: white;
  border-color: #b69b63;
}

/* OPCION NO */

.respuesta-card.no.activa {
  background: #eee4df;

  border-color: #a98677;

  transform: scale(1.02);
}

.respuesta-card.no.activa .respuesta-icono,
.respuesta-card.no.activa .check {
  background: #9c7768;
  color: white;
  border-color: #9c7768;
}

/* BOTON FINAL */

.confirmar-rsvp {
  width: 100%;

  margin-top: 25px;

  padding: 18px 22px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border: none;

  border-radius: 50px;

  background: #27251f;

  color: white;

  font-family: Arial, Helvetica, sans-serif;

  font-size: 13px;

  letter-spacing: 0.07em;

  cursor: pointer;

  transition: .25s ease;
}

.confirmar-rsvp span {
  font-size: 20px;
}

.confirmar-rsvp:hover:not(:disabled) {
  transform: translateY(-2px);

  box-shadow:
    0 10px 30px rgba(0,0,0,0.12);
}

.confirmar-rsvp:disabled {
  opacity: 0.22;
  cursor: default;
}

/* GRACIAS */

.gracias-card {
  text-align: center;

  padding: 35px 25px;
}

.corazon-grande {
  font-size: 70px;

  margin-bottom: 5px;
}

.gracias-card h2 {
  margin: 0;

  font-family:
    "Segoe Script",
    "Brush Script MT",
    cursive;

  font-size: clamp(70px, 19vw, 105px);

  font-weight: 400;
}

.gracias-card p {
  margin: 10px 0 30px;

  color: #777167;
}

.firma-final {
  font-family:
    "Segoe Script",
    "Brush Script MT",
    cursive;

  font-size: 28px;
}



/* =====================================
   ANIMACIONES ESTILO ILUSTRACION / DIBUJO
   ===================================== */

.experiencia {
  position: relative;
  overflow: hidden;
}

.experiencia::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  opacity: 0.12;
  background:
    radial-gradient(circle at 20% 20%, rgba(0,0,0,0.05) 0, transparent 28%),
    radial-gradient(circle at 80% 30%, rgba(0,0,0,0.04) 0, transparent 24%),
    radial-gradient(circle at 40% 80%, rgba(0,0,0,0.04) 0, transparent 22%);
  animation: papelVivo 14s ease-in-out infinite alternate;
}

/* Capas principales por encima del papel */
.pantalla,
.contenido,
.texto-central,
.respuesta-contenido,
.civil,
.fecha-gigante,
.frase-grande,
.ilustracion {
  position: relative;
  z-index: 2;
}

/* ILUSTRACIONES */
.ilustracion {
  transform-origin: center bottom;
  animation:
    flotarDibujo 5.5s ease-in-out infinite,
    vibracionLapiz 8s steps(2, end) infinite;
  filter: saturate(0.98) contrast(1.02);
}

/* PORTADA */
.nombres > span {
  animation: entradaTrazo 0.9s ease both;
}

.nombres > span:nth-child(1) {
  animation-delay: 0.05s;
}

.nombres > span.y {
  animation-delay: 0.18s;
}

.nombres > span:nth-child(3) {
  animation-delay: 0.32s;
}

.linea-portada,
.linea {
  transform-origin: center;
  animation: dibujarLinea 1s ease-out both;
  animation-delay: 0.35s;
}

.fecha-principal {
  animation: entradaSuave 0.9s ease both;
  animation-delay: 0.45s;
}

/* SEGUNDA Y TERCERA */
.frase-grande {
  animation: entradaTrazo 1s ease both;
}

.frase-grande strong {
  display: block;
  animation: latidoSuave 4.5s ease-in-out infinite;
  animation-delay: 1s;
}

.fecha-gigante {
  animation: entradaSuave 0.9s ease both;
}

.fecha-gigante p:first-child {
  animation: entradaTrazo 0.9s ease both;
  animation-delay: 0.05s;
}

.fecha-gigante span {
  animation: entradaSuave 0.9s ease both;
  animation-delay: 0.25s;
}

.fecha-gigante p:last-child {
  animation: entradaTrazo 0.9s ease both;
  animation-delay: 0.45s;
}

/* CIVIL */
.civil {
  animation: entradaSuave 0.9s ease both;
}

.civil h2 {
  animation: entradaTrazo 0.9s ease both;
  animation-delay: 0.08s;
}

.datos {
  animation: entradaSuave 0.9s ease both;
  animation-delay: 0.28s;
}

/* RSVP */
.respuesta-contenido {
  animation: entradaSuave 0.8s ease both;
}

.respuesta-card {
  position: relative;
  overflow: hidden;
  transition:
    transform .25s ease,
    box-shadow .25s ease,
    border-color .25s ease,
    background .25s ease;
}

.respuesta-card::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  background: linear-gradient(
    120deg,
    transparent 0%,
    rgba(255,255,255,0.15) 45%,
    rgba(255,255,255,0.35) 50%,
    transparent 55%
  );
  transform: translateX(-120%);
}

.respuesta-card:hover {
  transform: translateY(-3px) rotate(-0.3deg);
}

.respuesta-card:hover::after {
  opacity: 1;
  animation: brilloLapiz 1.1s ease;
}

.respuesta-card.activa,
.respuesta-card.si.activa,
.respuesta-card.duda.activa,
.respuesta-card.no.activa {
  animation: selloSuave 0.35s ease-out;
}

.respuesta-icono {
  animation: latidoSuave 4s ease-in-out infinite;
}

.confirmar-rsvp {
  transition:
    transform .25s ease,
    box-shadow .25s ease,
    opacity .25s ease;
}

.confirmar-rsvp:hover:not(:disabled) {
  transform: translateY(-2px) scale(1.01);
}

.gracias-card {
  animation: entradaTrazo 0.9s ease both;
}

.corazon-grande {
  animation: latidoSuave 2.8s ease-in-out infinite;
}

/* CONTINUAR */
.continuar {
  animation:
    reboteSuave 1.8s ease-in-out infinite,
    vibracionLapiz 10s steps(2, end) infinite;
}

/* KEYFRAMES */

@keyframes entradaTrazo {
  0% {
    opacity: 0;
    transform: translateY(16px) scale(0.98) rotate(-0.5deg);
    filter: blur(1px);
  }
  60% {
    opacity: 1;
    transform: translateY(-2px) scale(1.01) rotate(0.3deg);
    filter: blur(0);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1) rotate(0deg);
    filter: blur(0);
  }
}

@keyframes entradaSuave {
  0% {
    opacity: 0;
    transform: translateY(22px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes dibujarLinea {
  0% {
    opacity: 0;
    transform: scaleX(0);
  }
  100% {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes flotarDibujo {
  0% {
    transform: translateY(0px) rotate(-0.4deg);
  }
  50% {
    transform: translateY(-8px) rotate(0.4deg);
  }
  100% {
    transform: translateY(0px) rotate(-0.4deg);
  }
}

@keyframes vibracionLapiz {
  0% {
    filter: saturate(0.98) contrast(1.02);
  }
  50% {
    filter: saturate(1) contrast(1.03);
  }
  100% {
    filter: saturate(0.98) contrast(1.02);
  }
}

@keyframes latidoSuave {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.035);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes reboteSuave {
  0%, 100% {
    transform: translateX(-50%) translateY(0);
  }
  50% {
    transform: translateX(-50%) translateY(5px);
  }
}

@keyframes brilloLapiz {
  0% {
    transform: translateX(-120%);
  }
  100% {
    transform: translateX(120%);
  }
}

@keyframes selloSuave {
  0% {
    transform: scale(0.96) rotate(-0.5deg);
  }
  60% {
    transform: scale(1.03) rotate(0.4deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
  }
}

@keyframes papelVivo {
  0% {
    transform: scale(1) translateY(0);
    opacity: 0.1;
  }
  100% {
    transform: scale(1.03) translateY(-6px);
    opacity: 0.15;
  }
}


.flecha-abajo {
  width: 8px;
  height: 8px;
  display: inline-block;
  border-right: 1px solid #25241f;
  border-bottom: 1px solid #25241f;
  transform: rotate(45deg);
  margin-left: 8px;
}

.flecha-boton {
  font-size: 24px;
  line-height: 1;
}


/* =====================================
   FONDO DINAMICO MAPUCHE / ANDINO SUTIL
   ===================================== */

.experiencia {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.bg-motifs {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.pantalla,
.contenido,
.texto-central,
.respuesta-contenido,
.civil,
.fecha-gigante,
.frase-grande,
.indicador,
.volver,
.continuar {
  position: relative;
  z-index: 2;
}

.motif {
  position: absolute;
  opacity: 0.07;
  filter: blur(0.15px);
  will-change: transform, opacity;
}

/* Sol andino sutil */
.motif-sun {
  width: 220px;
  height: 220px;
  top: 8%;
  right: -40px;
  border-radius: 50%;
  border: 2px solid rgba(34, 33, 29, 0.16);
  background:
    radial-gradient(circle at center,
      rgba(34, 33, 29, 0.08) 0 14%,
      transparent 15% 100%);
  box-shadow:
    0 0 0 18px rgba(34, 33, 29, 0.03),
    0 0 0 36px rgba(34, 33, 29, 0.02);
  animation: motifRotate 28s linear infinite;
}

.motif-sun::before,
.motif-sun::after {
  content: "";
  position: absolute;
  inset: -22px;
  border-radius: 50%;
  background:
    conic-gradient(
      from 0deg,
      rgba(34, 33, 29, 0.12) 0deg 8deg,
      transparent 8deg 22deg,
      rgba(34, 33, 29, 0.12) 22deg 30deg,
      transparent 30deg 45deg,
      rgba(34, 33, 29, 0.12) 45deg 53deg,
      transparent 53deg 68deg,
      rgba(34, 33, 29, 0.12) 68deg 76deg,
      transparent 76deg 90deg,
      rgba(34, 33, 29, 0.12) 90deg 98deg,
      transparent 98deg 112deg,
      rgba(34, 33, 29, 0.12) 112deg 120deg,
      transparent 120deg 135deg,
      rgba(34, 33, 29, 0.12) 135deg 143deg,
      transparent 143deg 158deg,
      rgba(34, 33, 29, 0.12) 158deg 166deg,
      transparent 166deg 180deg,
      rgba(34, 33, 29, 0.12) 180deg 188deg,
      transparent 188deg 202deg,
      rgba(34, 33, 29, 0.12) 202deg 210deg,
      transparent 210deg 225deg,
      rgba(34, 33, 29, 0.12) 225deg 233deg,
      transparent 233deg 248deg,
      rgba(34, 33, 29, 0.12) 248deg 256deg,
      transparent 256deg 270deg,
      rgba(34, 33, 29, 0.12) 270deg 278deg,
      transparent 278deg 292deg,
      rgba(34, 33, 29, 0.12) 292deg 300deg,
      transparent 300deg 315deg,
      rgba(34, 33, 29, 0.12) 315deg 323deg,
      transparent 323deg 338deg,
      rgba(34, 33, 29, 0.12) 338deg 346deg,
      transparent 346deg 360deg
    );
  mask: radial-gradient(circle, transparent 0 72%, black 73% 100%);
}

.motif-sun::after {
  inset: 18px;
  opacity: 0.65;
  animation: motifPulse 7s ease-in-out infinite;
}

/* Escalonados andinos */
.motif-step {
  width: 180px;
  height: 180px;
  background:
    linear-gradient(rgba(34, 33, 29, 0.12), rgba(34, 33, 29, 0.12)) 0 0 / 22px 22px no-repeat,
    linear-gradient(rgba(34, 33, 29, 0.12), rgba(34, 33, 29, 0.12)) 22px 0 / 22px 22px no-repeat,
    linear-gradient(rgba(34, 33, 29, 0.12), rgba(34, 33, 29, 0.12)) 44px 22px / 22px 22px no-repeat,
    linear-gradient(rgba(34, 33, 29, 0.12), rgba(34, 33, 29, 0.12)) 66px 44px / 22px 22px no-repeat,
    linear-gradient(rgba(34, 33, 29, 0.12), rgba(34, 33, 29, 0.12)) 88px 66px / 22px 22px no-repeat,
    linear-gradient(rgba(34, 33, 29, 0.12), rgba(34, 33, 29, 0.12)) 110px 88px / 22px 22px no-repeat,
    linear-gradient(rgba(34, 33, 29, 0.12), rgba(34, 33, 29, 0.12)) 132px 110px / 22px 22px no-repeat;
}

.motif-step-1 {
  top: 18%;
  left: -20px;
  transform: rotate(-12deg);
  animation: motifFloatA 13s ease-in-out infinite;
}

.motif-step-2 {
  bottom: 14%;
  right: 5%;
  transform: rotate(18deg) scale(0.88);
  animation: motifFloatB 17s ease-in-out infinite;
}

/* Rombo textil mapuche */
.motif-diamond {
  width: 210px;
  height: 210px;
  left: 8%;
  bottom: 9%;
  transform: rotate(45deg);
  background:
    linear-gradient(45deg,
      transparent 0 34%,
      rgba(34, 33, 29, 0.11) 34% 36%,
      transparent 36% 64%,
      rgba(34, 33, 29, 0.11) 64% 66%,
      transparent 66% 100%),
    linear-gradient(-45deg,
      transparent 0 34%,
      rgba(34, 33, 29, 0.11) 34% 36%,
      transparent 36% 64%,
      rgba(34, 33, 29, 0.11) 64% 66%,
      transparent 66% 100%);
  animation: motifFloatA 15s ease-in-out infinite;
}

/* Lineas organicas sutiles */
.motif-flow {
  width: 260px;
  height: 260px;
  border-radius: 50%;
  border: 1px solid rgba(34, 33, 29, 0.12);
  border-color: rgba(34, 33, 29, 0.10) transparent transparent transparent;
}

.motif-flow::before,
.motif-flow::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  inset: 22px;
  border: 1px solid rgba(34, 33, 29, 0.10);
  border-color: transparent rgba(34, 33, 29, 0.10) transparent transparent;
}

.motif-flow::after {
  inset: 48px;
  border-color: rgba(34, 33, 29, 0.08) transparent transparent transparent;
}

.motif-flow-1 {
  top: 52%;
  left: -80px;
  animation: motifRotateReverse 32s linear infinite;
}

.motif-flow-2 {
  top: 10%;
  right: 12%;
  transform: scale(0.72);
  animation: motifRotate 36s linear infinite;
}

/* Banda textil inferior */
.motif-band {
  left: 0;
  right: 0;
  bottom: 0;
  height: 56px;
  opacity: 0.05;
  background:
    linear-gradient(135deg,
      transparent 0 12px,
      rgba(34, 33, 29, 0.18) 12px 18px,
      transparent 18px 36px) 0 0 / 72px 56px repeat-x,
    linear-gradient(225deg,
      transparent 0 12px,
      rgba(34, 33, 29, 0.18) 12px 18px,
      transparent 18px 36px) 36px 0 / 72px 56px repeat-x;
  animation: motifDriftX 26s linear infinite;
}

/* Animaciones */
@keyframes motifFloatA {
  0%   { transform: translateY(0px) rotate(-12deg); }
  50%  { transform: translateY(-12px) rotate(-8deg); }
  100% { transform: translateY(0px) rotate(-12deg); }
}

@keyframes motifFloatB {
  0%   { transform: translateY(0px) rotate(18deg) scale(0.88); }
  50%  { transform: translateY(10px) rotate(14deg) scale(0.9); }
  100% { transform: translateY(0px) rotate(18deg) scale(0.88); }
}

@keyframes motifRotate {
  0%   { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes motifRotateReverse {
  0%   { transform: rotate(0deg) scale(1); }
  100% { transform: rotate(-360deg) scale(1); }
}

@keyframes motifPulse {
  0%   { opacity: 0.35; transform: scale(1); }
  50%  { opacity: 0.7; transform: scale(1.03); }
  100% { opacity: 0.35; transform: scale(1); }
}

@keyframes motifDriftX {
  0%   { background-position: 0 0, 36px 0; }
  100% { background-position: 72px 0, 108px 0; }
}

/* Mobile */
@media (max-width: 700px) {
  .motif-sun {
    width: 160px;
    height: 160px;
    top: 7%;
    right: -35px;
  }

  .motif-step {
    width: 120px;
    height: 120px;
  }

  .motif-diamond {
    width: 150px;
    height: 150px;
    left: -20px;
    bottom: 10%;
  }

  .motif-flow {
    width: 180px;
    height: 180px;
  }

  .motif-band {
    height: 42px;
  }
}


/* =========================================
   FIX FONDO ILUSTRADO + CONTINUAR
   ========================================= */

/* Recupera posicion correcta de continuar */

.continuar {
  position: absolute !important;
  left: 50% !important;
  bottom: 25px !important;
  top: auto !important;

  z-index: 50 !important;

  transform: translateX(-50%);

  display: flex;
  align-items: center;
  gap: 9px;

  white-space: nowrap;
}


/* Fondo siempre por detras */

.bg-motifs {
  position: fixed !important;
  inset: 0;

  overflow: hidden;

  pointer-events: none;

  z-index: 1 !important;
}


/* Contenido por encima */

.pantalla,
.contenido,
.portada-texto,
.frase-grande,
.fecha-gigante,
.civil,
.respuesta-contenido {
  z-index: 5;
}


/* Motivos ahora SI visibles */

.motif {
  opacity: 0.20 !important;
}


/* SOL ANDINO */

.motif-sun {
  width: 240px !important;
  height: 240px !important;

  top: 7% !important;
  right: -65px !important;

  border: 2px solid rgba(35, 33, 29, 0.25) !important;

  box-shadow:
    0 0 0 16px rgba(35,33,29,0.035),
    0 0 0 34px rgba(35,33,29,0.028),
    0 0 0 52px rgba(35,33,29,0.018) !important;
}


/* ESCALONADO SUPERIOR IZQUIERDO */

.motif-step-1 {
  top: 22% !important;
  left: -5px !important;

  opacity: 0.22 !important;
}


/* ESCALONADO INFERIOR */

.motif-step-2 {
  right: 2% !important;
  bottom: 12% !important;

  opacity: 0.15 !important;
}


/* ROMBO TEXTIL */

.motif-diamond {
  width: 180px !important;
  height: 180px !important;

  left: 4% !important;
  bottom: 10% !important;

  opacity: 0.18 !important;
}


/* Formas lineales */

.motif-flow {
  opacity: 0.16 !important;
}


/* Banda inferior */

.motif-band {
  height: 62px !important;
  opacity: 0.16 !important;
}


/* Agregamos una trama geometrica sutil */

.bg-motifs::before {
  content: "";

  position: absolute;

  width: 180px;
  height: 520px;

  left: -55px;
  top: 32%;

  opacity: 0.10;

  background:
    linear-gradient(
      45deg,
      transparent 42%,
      #24231f 43%,
      #24231f 47%,
      transparent 48%
    ),
    linear-gradient(
      -45deg,
      transparent 42%,
      #24231f 43%,
      #24231f 47%,
      transparent 48%
    );

  background-size: 44px 44px;

  transform: rotate(-5deg);

  animation: tramaVertical 22s linear infinite;
}


/* Segundo detalle tipo guardas */

.bg-motifs::after {
  content: "";

  position: absolute;

  width: 360px;
  height: 80px;

  right: -80px;
  bottom: 5%;

  opacity: 0.10;

  background:
    linear-gradient(
      135deg,
      transparent 25%,
      #24231f 26%,
      #24231f 32%,
      transparent 33%,
      transparent 65%,
      #24231f 66%,
      #24231f 72%,
      transparent 73%
    );

  background-size: 58px 58px;

  animation: tramaHorizontal 25s linear infinite;
}


@keyframes tramaVertical {
  from {
    transform: translateY(0) rotate(-5deg);
  }

  to {
    transform: translateY(-44px) rotate(-5deg);
  }
}


@keyframes tramaHorizontal {
  from {
    background-position: 0 0;
  }

  to {
    background-position: 116px 0;
  }
}


/* MOVIL */

@media (max-width: 700px) {

  .motif-sun {
    width: 170px !important;
    height: 170px !important;

    right: -55px !important;
    top: 9% !important;
  }

  .bg-motifs::before {
    width: 120px;
    left: -45px;

    opacity: 0.09;
  }

  .bg-motifs::after {
    width: 250px;
    right: -70px;

    opacity: 0.09;
  }

  .continuar {
    bottom: 22px !important;
  }
}


/* INVITATION_BACKGROUND_V2_START */

.experiencia {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.invitation-background {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.pantalla {
  position: relative;
  z-index: 2;
}

.contenido {
  position: relative;
  z-index: 2;
}

.invite-motif {
  position: absolute;
  color: rgba(40, 38, 33, 0.95);
  pointer-events: none;
  will-change: transform, opacity;
  mix-blend-mode: multiply;
}

.invite-svg {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.invite-ink * {
  stroke: currentColor;
  vector-effect: non-scaling-stroke;
}

.invite-sun {
  width: min(28vw, 230px);
  height: min(28vw, 230px);
  top: 5%;
  right: -24px;
}

.invite-diamond {
  width: min(23vw, 175px);
  height: min(23vw, 175px);
  left: 4%;
  bottom: 11%;
}

.invite-steps {
  width: min(22vw, 175px);
  height: min(27vw, 210px);
  top: 22%;
  left: -8px;
}

.invite-flow {
  width: min(34vw, 310px);
  height: min(25vw, 220px);
  right: 4%;
  bottom: 17%;
}

.invite-band {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;

  height: 54px;

  background:
    linear-gradient(
      135deg,
      transparent 0 13px,
      rgba(40, 38, 33, 0.95) 13px 18px,
      transparent 18px 34px
    )
    0 0 / 68px 54px repeat-x,

    linear-gradient(
      225deg,
      transparent 0 13px,
      rgba(40, 38, 33, 0.95) 13px 18px,
      transparent 18px 34px
    )
    34px 0 / 68px 54px repeat-x;

  mix-blend-mode: multiply;
}

.invite-particles {
  position: absolute;
  inset: 0;
}

.invite-particle {
  position: absolute;

  display: block;

  border-radius: 50%;

  background: rgba(40, 38, 33, 0.85);

  filter: blur(0.15px);

  box-shadow:
    0 0 4px rgba(40, 38, 33, 0.08);
}


/* Screen 0 */

.screen-0 .invite-sun {
  filter: blur(0);
}

.screen-0 .invite-diamond {
  transform: rotate(45deg);
}


/* Screen 1 */

.screen-1 .invite-flow {
  filter: blur(0);
}

.screen-1 .invite-sun {
  transform: scale(0.9);
}


/* Screen 2 */

.screen-2 .invite-diamond {
  transform: rotate(45deg) scale(1.12);
}

.screen-2 .invite-sun {
  transform: scale(0.82);
}


/* Screen 3 */

.screen-3 .invite-steps {
  transform: scale(1.08);
}


/* RSVP cleaner */

.screen-4 .invite-sun,
.screen-4 .invite-diamond,
.screen-4 .invite-steps,
.screen-4 .invite-flow,
.screen-4 .invite-band {
  filter: blur(0.1px);
}


/* Restore continue position */

.continuar {
  position: absolute !important;

  left: 50% !important;
  right: auto !important;

  top: auto !important;
  bottom: 24px !important;

  z-index: 40 !important;

  transform: translateX(-50%) !important;

  display: flex;
  align-items: center;
  justify-content: center;

  white-space: nowrap;
}


/* Do not allow background rules to move it */

.contenido > .continuar {
  position: absolute !important;
}


/* Mobile */

@media (max-width: 700px) {

  .invite-sun {
    width: 160px;
    height: 160px;

    top: 6%;
    right: -42px;
  }

  .invite-diamond {
    width: 118px;
    height: 118px;

    left: -10px;
    bottom: 12%;
  }

  .invite-steps {
    width: 110px;
    height: 145px;

    top: 23%;
    left: -18px;
  }

  .invite-flow {
    width: 200px;
    height: 150px;

    right: -24px;
    bottom: 16%;
  }

  .invite-band {
    height: 39px;

    background-size:
      56px 39px,
      56px 39px;

    background-position:
      0 0,
      28px 0;
  }

  .continuar {
    bottom: 20px !important;
  }
}


/* Reduced motion */

@media (prefers-reduced-motion: reduce) {

  .invite-motif,
  .invite-particle,
  .invite-band {
    animation: none !important;
  }
}

/* INVITATION_BACKGROUND_V2_END */
