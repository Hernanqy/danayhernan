            delay={0}
          />


          <FloatingImage
            src="/icons/m.png"
            alt="Mate"
            delay={0.25}
          />


          <FloatingImage
            src="/icons/r.png"
            alt="Reposera"
            delay={0.5}
          />


          <FloatingImage
            src="/icons/to.png"
