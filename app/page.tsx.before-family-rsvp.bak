}


/* =========================================================
   SCREEN 5 RSVP
   ========================================================= */

function RsvpScreen({
  next,
}: {
  next: () => void;
}) {

  const [open, setOpen] =
    useState(false);


  const [name, setName] =
    useState("");


  const [answer, setAnswer] =
    useState<Answer>(null);


  const [sending, setSending] =
    useState(false);


  const [error, setError] =
    useState("");


  /*
    IMPORTANT:
    This ref blocks a second click immediately.
    State alone can take one render to update.
  */

  const sendingRef =
    useRef(false);


  const confirm =
    async () => {

      /*
        If the first click already started,
        ignore every following click.
      */

      if (
        !name.trim() ||
        !answer ||
        sendingRef.current
      ) {
        return;
      }


      /*
        Lock synchronously before doing
        any async operation.
      */

      sendingRef.current = true;

      setSending(true);

      setError("");


      try {

        const body =
          new URLSearchParams();


        body.append(
          "nombre",
          name.trim()
        );


        body.append(
          "respuesta",
          answer
        );


        await fetch(

          RSVP_URL,

          {
            method: "POST",

            mode: "no-cors",

            body,
          }

        );


        /*
          Only after the request was sent,
          go to final screen.
        */

        next();

      }

      catch (err) {

        console.error(err);


        /*
          Unlock only if there was
          an actual transmission error.
        */

        sendingRef.current = false;

        setSending(false);


        setError(
          "No se pudo enviar la respuesta. Intenta nuevamente."
        );

      }

    };


  return (

    <div className="screen-content rsvp-screen">

      <motion.div

        className="rsvp-content"

        initial={{
          opacity: 0,
          scale: 0.96,
        }}

        animate={{
          opacity: 1,
          scale: 1,
        }}

      >

        <h1>

          {
            "\u00BFVEN\u00CDS?"
          }

        </h1>


        {!open && (

          <motion.button

            type="button"

            className="main-rsvp-button"

            onClick={() =>
              setOpen(true)
            }

            whileTap={{
              scale: 0.97,
            }}

          >

            {
              "CONFIRMAR ASISTENCIA \u2192"
            }

          </motion.button>

        )}


        <AnimatePresence>

          {open && (

            <motion.div

              className="rsvp-form"

              initial={{
                opacity: 0,
                y: 20,
              }}

              animate={{
                opacity: 1,
                y: 0,
              }}

              exit={{
                opacity: 0,
              }}

            >

              <label>

                Tu nombre


                <input

                  type="text"

                  placeholder="Nombre y apellido"

                  value={name}

                  disabled={sending}

                  onChange={(event) =>
                    setName(
                      event.target.value
                    )
                  }

                  autoComplete="name"

                />

              </label>


              <div className="rsvp-options">


                <RsvpOption

                  active={
                    answer === "yes"
                  }

                  disabled={
                    sending
                  }

                  onClick={() =>
                    setAnswer("yes")
                  }

                >

                  {
                    "S\u00CD, VOY"
                  }

                </RsvpOption>


                <RsvpOption

                  active={
                    answer === "maybe"
                  }

                  disabled={
                    sending
                  }

                  onClick={() =>
                    setAnswer(
                      "maybe"
                    )
                  }

                >

                  {
                    "TODAV\u00CDA NO S\u00C9"
                  }

                </RsvpOption>


                <RsvpOption

                  active={
                    answer === "no"
                  }

                  disabled={
                    sending
                  }

                  onClick={() =>
                    setAnswer("no")
                  }

                >

                  NO VOY A PODER

                </RsvpOption>


              </div>


              {error && (

                <p className="rsvp-error">

                  {error}

                </p>

              )}


              <button

                type="button"

                className="send-rsvp"

                disabled={
                  !name.trim() ||
                  !answer ||
                  sending
                }

                onClick={confirm}

              >

                {
                  sending
                    ? "ENVIANDO..."
                    : "ENVIAR RESPUESTA \u2192"
                }

              </button>

            </motion.div>

          )}

        </AnimatePresence>

      </motion.div>

    </div>

  );

}


/* =========================================================
   FINAL
   ========================================================= */

function FinalScreen() {

  return (

    <div className="screen-content final-screen">

      <motion.div

        className="final-content"

        initial={{
          opacity: 0,
          scale: 0.92,
        }}

        animate={{
          opacity: 1,
          scale: 1,
        }}

        transition={{
          duration: 0.9,
        }}

      >

        <p className="names">

          {
            "DANA & HERN\u00C1N"
          }

        </p>


        <motion.div

          className="final-heart"

          animate={{
            scale: [
              1,
              1.08,
              1,
            ],
          }}

          transition={{
            duration: 2,
            repeat: Infinity,
            ease: "easeInOut",
          }}

        >

          {
            "\u2764\uFE0F"
          }

        </motion.div>


        <p className="final-message">

          {
            "Nos vemos el 4 de diciembre \u2764\uFE0F"
          }

        </p>

      </motion.div>

    </div>

  );

}


/* =========================================================
   NEXT BUTTON
   ========================================================= */

function NextButton({
  next,
}: {
  next: () => void;
}) {

  return (

    <motion.button

      type="button"

      className="next-button"

      onClick={next}

      animate={{
        x: [
          0,
          4,
          0,
        ],
      }}

      transition={{
        duration: 2,
        repeat: Infinity,
        ease: "easeInOut",
      }}

    >

      {
        "\u2192"
      }

    </motion.button>

  );

}


/* =========================================================
   RSVP OPTION
   ========================================================= */

function RsvpOption({
  active,
  disabled,
  onClick,
  children,
}: {
  active: boolean;
  disabled: boolean;
  onClick: () => void;
  children: ReactNode;
}) {

  return (

    <motion.button

      type="button"

      disabled={disabled}

      className={
        active
          ? "rsvp-option active"
          : "rsvp-option"
      }

      onClick={onClick}

      whileTap={
        disabled
          ? undefined
          : {
              scale: 0.97,
            }
      }

    >

      <span className="option-circle">

        {
          active
            ? "OK"
            : ""
        }

      </span>


      <span>

        {children}

      </span>

    </motion.button>

  );

}


/* =========================================================
   FLOATING PNG ICONS
   ========================================================= */

function FloatingImage({
  src,
  alt,
  delay,
}: {
  src: string;
  alt: string;
  delay: number;
}) {

  return (

    <motion.div

      className="party-png-wrap"

      animate={{
        y: [
          0,
          -6,
          0,
        ],

        rotate: [
          0,
          1.5,
          0,
          -1,
          0,
        ],
      }}

      transition={{
        duration: 5,
        delay,
        repeat: Infinity,
        ease: "easeInOut",
      }}

    >

      <img

        src={src}

        alt={alt}

        className="party-png"

      />

    </motion.div>

  );

}


/* =========================================================
   BACKGROUND
   ========================================================= */

function DoodleBackground({
  screen,
}: {
  screen: number;
}) {

  return (

    <div

      className={
        `doodle-background doodle-screen-${screen}`
      }

      aria-hidden="true"

    >

      <motion.div

        className="doodle doodle-one"

        animate={{
          y: [
            0,
            -10,
            0,
          ],

          rotate: [
            -7,
            -3,
            -7,
          ],
        }}

        transition={{
          duration: 10,
          repeat: Infinity,
          ease: "easeInOut",
        }}

      >

        <HeartIcon />

      </motion.div>


      <motion.div

        className="doodle doodle-two"

        animate={{
          y: [
            0,
            8,
            0,
          ],
        }}

        transition={{
          duration: 13,
          repeat: Infinity,
          ease: "easeInOut",
        }}

      >

        <MusicIcon />

      </motion.div>


      <div className="ink-particles">

        {
          Array.from({
            length: 12,
          }).map(
            (_, index) => (

              <motion.i

                key={index}

                style={{
                  left:
                    `${
                      7 +
                      (
                        (
                          index *
                          17
                        ) %
                        86
                      )
                    }%`,

                  top:
                    `${
                      9 +
                      (
                        (
                          index *
                          23
                        ) %
                        82
                      )
                    }%`,
                }}

                animate={{
                  y: [
                    0,
                    -8,
                    0,
                  ],

                  opacity: [
                    0.08,
                    0.22,
                    0.08,
                  ],
                }}

                transition={{
                  duration:
                    6 +
                    (
                      index %
                      5
                    ),

                  delay:
                    index *
                    0.17,

                  repeat:
                    Infinity,

                  ease:
                    "easeInOut",
                }}

              />

            )
          )
        }

      </div>

    </div>

  );

}


