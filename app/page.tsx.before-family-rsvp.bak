        }}

        transition={{
          duration: 0.8,
        }}

      >

        <span>
          04
        </span>

        <i />

        <span>
          12
        </span>

        <i />

        <span>
          2026
        </span>

      </motion.div>


      <NextButton next={next} />

    </div>

  );

}


/* =========================================================
   SCREEN 4
   ========================================================= */

