            delay={0}
          />

          <FloatingImage
            src="/icons/m.png"
            alt="Mate"
            delay={0.2}
          />

          <FloatingImage
            src="/icons/r.png"
            alt="Reposera"
            delay={0.4}
          />

          <FloatingImage
            src="/icons/to.png"
            alt="Torta"
            delay={0.6}
          />

        </div>

      </motion.div>


      <NextButton next={next} />

    </div>

