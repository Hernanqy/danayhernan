}


/* =========================================================
   CONFIRMACION
   ========================================================= */

function RsvpScreen({
  next,
}: {
  next: () => void;
}) {

  const [open, setOpen] =
    useState(false);

  const [name, setName] =
    useState("");

  const [answer, setAnswer] =
    useState<Answer>(null);

  const [companions, setCompanions] =
    useState(0);

  const [sending, setSending] =
    useState(false);

  const [error, setError] =
    useState("");

  const sendingRef =
    useRef(false);


  const chooseAnswer = (
    value: NonNullable<Answer>
  ) => {

    if (sendingRef.current) {
      return;
    }

    setAnswer(value);

    if (value !== "yes") {
      setCompanions(0);
    }

  };


  const confirm =
    async () => {

      if (
        !name.trim() ||
        !answer ||
        sendingRef.current
      ) {
        return;
      }


      sendingRef.current = true;

      setSending(true);

      setError("");


      try {

        const body =
          new URLSearchParams();


        body.append(
          "nombre",
          name.trim()
        );


        body.append(
          "respuesta",
          answer
        );


        body.append(
          "acompanantes",
          answer === "yes"
            ? String(companions)
            : "0"
        );


        await fetch(
          RSVP_URL,
          {
            method: "POST",
            mode: "no-cors",
            body,
          }
        );


        next();

      }
      catch (err) {

        console.error(err);

        sendingRef.current = false;

        setSending(false);

        setError(
          "No se pudo enviar la respuesta. Intenta nuevamente."
        );

      }

    };


  return (

    <div className="screen-content rsvp-screen">

      <motion.div
        className="rsvp-content"
        initial={{
          opacity: 0,
          scale: 0.96,
        }}
        animate={{
          opacity: 1,
          scale: 1,
        }}
      >

        <h1>

          {
            "\u00BFVEN\u00CDS?"
          }

        </h1>


        {!open && (

          <motion.button
            type="button"
            className="main-rsvp-button"
            onClick={() =>
              setOpen(true)
            }
            whileTap={{
              scale: 0.97,
            }}
          >

            {
              "CONFIRMAR ASISTENCIA \u2192"
            }

          </motion.button>

        )}


        <AnimatePresence>

          {open && (

            <motion.div
              className="rsvp-form"
              initial={{
                opacity: 0,
                y: 16,
              }}
              animate={{
                opacity: 1,
                y: 0,
              }}
              exit={{
                opacity: 0,
              }}
            >

              <label className="name-label">

                Tu nombre

                <input
                  type="text"
                  placeholder="Nombre y apellido"
                  value={name}
                  disabled={sending}
                  onChange={(event) =>
                    setName(
                      event.target.value
                    )
                  }
                  autoComplete="name"
                />

              </label>


              <div className="rsvp-options">

                <RsvpOption
                  active={
                    answer === "yes"
                  }
                  disabled={sending}
                  onClick={() =>
                    chooseAnswer("yes")
                  }
                >

                  {
                    "S\u00CD, VOY"
                  }

                </RsvpOption>


                <RsvpOption
                  active={
                    answer === "maybe"
                  }
                  disabled={sending}
                  onClick={() =>
                    chooseAnswer("maybe")
                  }
                >

                  {
                    "TODAV\u00CDA NO S\u00C9"
                  }

                </RsvpOption>


                <RsvpOption
                  active={
                    answer === "no"
                  }
                  disabled={sending}
                  onClick={() =>
                    chooseAnswer("no")
                  }
                >

                  NO VOY A PODER

                </RsvpOption>

              </div>


              <AnimatePresence>

                {answer === "yes" && (

                  <motion.div
                    className="companions-card"
                    initial={{
                      opacity: 0,
                      y: 14,
                    }}
                    animate={{
                      opacity: 1,
                      y: 0,
                    }}
                    exit={{
                      opacity: 0,
                      y: 10,
                    }}
                    transition={{
                      duration: 0.35,
                    }}
                  >

                    <p className="companions-title">

                      {
                        "\u00BFCon cu\u00E1ntas personas m\u00E1s ven\u00EDs?"
                      }

                    </p>


                    <p className="companions-help">

                      {
                        "No te cuentes a vos. Sum\u00E1 pareja, familia o acompa\u00F1antes."
                      }

                    </p>


                    <div className="companions-stepper">

                      <button
                        type="button"
                        disabled={
                          sending ||
                          companions <= 0
                        }
                        onClick={() =>
                          setCompanions(
                            (value) =>
                              Math.max(
                                0,
                                value - 1
                              )
                          )
                        }
                      >
                        -
                      </button>


                      <motion.strong
                        key={companions}
                        initial={{
                          opacity: 0.4,
                          scale: 0.8,
                        }}
                        animate={{
                          opacity: 1,
                          scale: 1,
                        }}
                      >
                        {companions}
                      </motion.strong>


                      <button
                        type="button"
                        disabled={
                          sending ||
                          companions >= 10
                        }
                        onClick={() =>
                          setCompanions(
                            (value) =>
                              Math.min(
                                10,
                                value + 1
                              )
                          )
                        }
                      >
                        +
                      </button>

                    </div>


                    <p className="companions-total">

                      {
                        companions === 0
                          ? "Ven\u00EDs vos."
                          : `En total ser\u00EDan ${companions + 1} personas.`
                      }

                    </p>

                  </motion.div>

                )}

              </AnimatePresence>


              {error && (

                <p className="rsvp-error">
                  {error}
                </p>

              )}


              <button
                type="button"
                className="send-rsvp"
                disabled={
                  !name.trim() ||
                  !answer ||
                  sending
                }
                onClick={confirm}
              >

                {
                  sending
                    ? "ENVIANDO..."
                    : "ENVIAR RESPUESTA \u2192"
                }

              </button>

            </motion.div>

          )}

        </AnimatePresence>

      </motion.div>

    </div>

  );

}


