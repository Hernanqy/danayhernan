        }}
        animate={{
          opacity: 1,
          scale: 1,
        }}
        transition={{
          duration: 0.9,
        }}
      >

        <p className="names">

          {
            "DANA Y HERN\u00C1N"
          }

        </p>


        <motion.div
          className="final-heart"
          animate={{
            scale: [
              1,
              1.1,
              1,
            ],
          }}
          transition={{
            duration: 1.8,
            repeat: Infinity,
            ease: "easeInOut",
          }}
        >

          {
            "\u2764\uFE0F"
          }

        </motion.div>


        <p className="final-message">

          {
            "Nos vemos el 4 de diciembre \u2764\uFE0F"
          }

        </p>

      </motion.div>

    </div>

  );

}


/* =========================================================
   CONTINUAR
   ========================================================= */

function NextButton({
  next,
}: {
  next: () => void;
}) {

  return (

    <div className="next-button-wrap">

      <motion.button
        type="button"
        className="next-button"
        onClick={next}
        animate={{
          scale: [
            1,
            1.045,
            1,
          ],
        }}
        transition={{
          duration: 1.8,
          repeat: Infinity,
          ease: "easeInOut",
        }}
        whileTap={{
          scale: 0.96,
        }}
      >

        {
          "CONTINUAR \u2192"
        }

      </motion.button>

    </div>

  );

}


/* =========================================================
   OPCION RSVP
   ========================================================= */

function RsvpOption({
  active,
  disabled,
  onClick,
  children,
}: {
  active: boolean;
  disabled: boolean;
  onClick: () => void;
  children: ReactNode;
}) {

  return (

    <motion.button
      type="button"
      disabled={disabled}
      className={
        active
          ? "rsvp-option active"
          : "rsvp-option"
      }
      onClick={onClick}
      whileTap={
        disabled
          ? undefined
          : {
              scale: 0.97,
            }
      }
    >

      <span className="option-circle">

        {
          active
            ? "\u2713"
            : ""
        }

      </span>


      <span>
        {children}
      </span>

    </motion.button>

  );

}


/* =========================================================
   PNG
   ========================================================= */

function FloatingImage({
  src,
  alt,
  delay,
}: {
  src: string;
  alt: string;
  delay: number;
}) {

  return (

    <motion.div
      className="party-png-wrap"
      animate={{
        y: [
          0,
          -6,
          0,
        ],
        rotate: [
          0,
          1.2,
          0,
          -1.2,
          0,
        ],
      }}
      transition={{
        duration: 5,
        delay,
        repeat: Infinity,
        ease: "easeInOut",
      }}
    >

      <img
        src={src}
        alt={alt}
        className="party-png"
      />

    </motion.div>

  );

}


/* =========================================================
   FONDO
   ========================================================= */

function DoodleBackground({
  screen,
}: {
  screen: number;
}) {

  return (

    <div
      className={
        `doodle-background doodle-screen-${screen}`
      }
      aria-hidden="true"
    >

      <motion.div
        className="doodle doodle-one"
        animate={{
          y: [
            0,
            -8,
            0,
          ],
          rotate: [
            -6,
            -2,
            -6,
          ],
        }}
        transition={{
          duration: 10,
          repeat: Infinity,
          ease: "easeInOut",
        }}
      >
        <HeartIcon />
      </motion.div>


      <motion.div
        className="doodle doodle-two"
        animate={{
          y: [
            0,
            7,
            0,
          ],
        }}
        transition={{
          duration: 13,
          repeat: Infinity,
          ease: "easeInOut",
        }}
      >
        <MusicIcon />
      </motion.div>


      <div className="ink-particles">

        {
          Array.from({
            length: 10,
          }).map(
            (_, index) => (

              <motion.i
                key={index}
                style={{
                  left:
                    `${
                      8 +
                      (
                        (
                          index *
                          19
                        ) %
                        84
                      )
                    }%`,
                  top:
                    `${
                      10 +
                      (
                        (
                          index *
                          21
                        ) %
                        78
                      )
                    }%`,
                }}
                animate={{
                  y: [
                    0,
                    -7,
                    0,
                  ],
                  opacity: [
                    0.05,
                    0.14,
                    0.05,
                  ],
                }}
                transition={{
                  duration:
                    6 +
                    (
                      index %
                      4
                    ),
                  delay:
                    index *
                    0.2,
                  repeat:
                    Infinity,
                  ease:
                    "easeInOut",
                }}
              />

            )
          )
        }

      </div>

    </div>

  );

}


