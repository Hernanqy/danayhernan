"use client";

import {
  useRef,
  useState,
  type ReactNode,
} from "react";

import {
  AnimatePresence,
  motion,
} from "framer-motion";


type Answer =
  | "yes"
  | "maybe"
  | "no"
  | null;


const TOTAL_SCREENS = 6;


const MAP_URL =
  "https://www.google.com/maps/search/?api=1&query=Calle+213+2370+Olavarria+Buenos+Aires";


const RSVP_URL =
  "https://script.google.com/macros/s/AKfycbwP3iwqTzRleyLlpbj4ebeb2i8XdKhqYT6hkwpjR5680C3gcFb-3XHVRybyhof78CeJCA/exec";


export default function Home() {

  const [screen, setScreen] =
    useState(0);

  const audioRef =
    useRef<HTMLAudioElement>(null);

  const [musicPlaying, setMusicPlaying] =
    useState(false);


  const next = () => {

    setScreen(
      (current) =>
        current <
        TOTAL_SCREENS - 1
          ? current + 1
          : current
    );

  };


  const previous = () => {

    setScreen(
      (current) =>
        current > 0
          ? current - 1
          : current
    );

  };


  const startMusic =
    async () => {

      const audio =
        audioRef.current;

      if (!audio) {
        return;
      }

      audio.volume = 0.35;

      try {

        await audio.play();

        setMusicPlaying(true);

      }
      catch (error) {

        console.error(error);

      }

    };


  const toggleMusic =
    async () => {

      const audio =
        audioRef.current;

      if (!audio) {
        return;
      }

      if (audio.paused) {

        try {

          await audio.play();

          setMusicPlaying(true);

        }
        catch (error) {

          console.error(error);

        }

      }
      else {

        audio.pause();

        setMusicPlaying(false);

      }

    };


  return (

    <main className="wedding-app">

      <audio
        ref={audioRef}
        src="/audio/musica.mp3"
        loop
        preload="auto"
      />


      {screen > 0 && (

        <button
          type="button"
          className="music-button"
          onClick={toggleMusic}
          aria-label={
            musicPlaying
              ? "Pausar musica"
              : "Reproducir musica"
          }
        >
          {
            musicPlaying
              ? "\u266B"
              : "\u266A"
          }
        </button>

      )}


      <AnimatePresence mode="wait">

        <motion.section
          key={screen}
          className="wedding-screen"
          initial={{
            opacity: 0,
            y: 12,
          }}
          animate={{
            opacity: 1,
            y: 0,
          }}
          exit={{
            opacity: 0,
            y: -12,
          }}
          transition={{
            duration: 0.5,
            ease: [
              0.22,
              1,
              0.36,
              1,
            ],
          }}
        >

          <DoodleBackground
            screen={screen}
          />


          {screen === 0 && (

            <CoverScreen
              next={next}
              startMusic={startMusic}
            />

          )}


          {screen === 1 && (

            <AnnouncementScreen
              next={next}
            />

          )}


          {screen === 2 && (

            <DateScreen
              next={next}
            />

          )}


          {screen === 3 && (

            <CelebrationScreen
              next={next}
            />

          )}


          {screen === 4 && (

            <RsvpScreen
              next={next}
            />

          )}


          {screen === 5 && (

            <FinalScreen />

          )}


          {screen > 0 &&
            screen < 5 && (

            <button
              type="button"
              className="back-button"
              onClick={previous}
              aria-label="Volver"
            >
              {"<"}
            </button>

          )}

        </motion.section>

      </AnimatePresence>

    </main>

  );

}


/* =========================================================
   PORTADA
   ========================================================= */

function CoverScreen({
  next,
  startMusic,
}: {
  next: () => void;
  startMusic: () => Promise<void>;
}) {

  const enter =
    async () => {

      await startMusic();

      next();

    };


  return (

    <div className="screen-content cover-screen">

      <motion.div
        className="cover-center"
        initial={{
          opacity: 0,
          scale: 0.95,
        }}
        animate={{
          opacity: 1,
          scale: 1,
        }}
        transition={{
          duration: 0.9,
        }}
      >

        
<p className="names names-stacked-mobile">
  <span>DANA</span>
  <span className="names-y">Y</span>
  <span>{"HERN\u00C1N"}</span>
</p>

        <motion.div
          className="hand-line"
          initial={{
            scaleX: 0,
          }}
          animate={{
            scaleX: 1,
          }}
          transition={{
            duration: 1,
            delay: 0.3,
          }}
        />

      </motion.div>


      <div className="enter-button-wrap">

        <motion.button
          type="button"
          className="enter-button"
          onClick={enter}
          animate={{
            scale: [
              1,
              1.055,
              1,
            ],
          }}
          transition={{
            duration: 1.6,
            repeat: Infinity,
            ease: "easeInOut",
          }}
          whileTap={{
            scale: 0.96,
          }}
        >

          {
            "Toc\u00E1 para entrar \u2192"
          }

        </motion.button>

      </div>

    </div>

  );

}


/* =========================================================
   MENSAJE
   ========================================================= */

