    <svg
      viewBox="0 0 64 64"
      className="line-icon"
    >

      <path
        d="M25 44 V15 L48 10 V38"
      />

      <path
        d="M25 24 L48 19"
      />

      <ellipse
        cx="18"
        cy="46"
        rx="7"
        ry="5"
      />

      <ellipse
        cx="41"
        cy="40"
        rx="7"
        ry="5"
      />

    </svg>

  );

}


