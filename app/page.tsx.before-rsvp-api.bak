        className="announcement-card"
        initial={{
          opacity: 0,
          scale: 0.96,
        }}
        animate={{
          opacity: 1,
          scale: 1,
        }}
        transition={{
          duration: 0.8,
        }}
      >

        <h1>

          {
            "\u00A1Nos casamos! \u2764\uFE0F"
          }

        </h1>


        <p>

          {
            "Gu\u00E1rdate esta fechita y te esperamos para celebrar con nosotros"
          }

        </p>

      </motion.div>


      <NextButton next={next} />

    </div>

  );

}


