  return (

    <svg
      viewBox="0 0 64 64"
      className="pin-icon"
    >

      <path
        d="M32 55 C25 45 16 36 16 26 C16 17 23 10 32 10 C41 10 48 17 48 26 C48 36 39 45 32 55 Z"
      />

      <circle
        cx="32"
        cy="26"
        r="6"
      />

    </svg>

  );

}